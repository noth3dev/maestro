DATABASE_URL=postgresql://127.0.0.1:55432/maestro_test
MAESTRO_EVIDENCE_DIR=/tmp/maestro-evidence
# All Git repositories and worktrees must resolve beneath this directory.
MAESTRO_WORKTREE_ROOT=/tmp/maestro-workspaces
MAESTRO_HOST=127.0.0.1
MAESTRO_PORT=4310
# Optional: only this already-authenticated operator may provision project access.
# MAESTRO_OPERATOR_PROVISIONING_ADMIN_ID=018f3c9b-7e71-7b44-ae23-3b5d4e8c9f05
PI_OFFLINE=1

# Native model runtime. Run apps/model-gateway as a separate process.
MAESTRO_MODEL_GATEWAY_URL=http://127.0.0.1:4321
# Must match the gateway's MAESTRO_MODEL_GATEWAY_TOKEN. Never commit this value.
# MAESTRO_MODEL_GATEWAY_TOKEN=
MAESTRO_MODEL_GATEWAY_OPERATOR_ID=local-operator
# Optional explicit opaque account refs; defaults to <provider>-<gateway operator>.
# MAESTRO_MODEL_ACCOUNT_REFS=openai=openai-local-operator,anthropic=anthropic-local-operator
# Exact provider-qualified model used by TUI free-text turns.
# MAESTRO_MODEL=openai/gpt-5
