{
  "name": "@maestro/carnegie",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && npm run typecheck:renderer && vite build",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "test:radial-electron": "node scripts/electron-radial-renderer-smoke.mjs",
    "test:a11y": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@maestro/api-client": "*",
    "@maestro/contracts": "*",
    "@maestro/local-backend": "*",
    "@xyflow/react": "^12.11.6",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^0.545.0",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "vite": "^6.0.0",
    "axe-core": "^4.11.0",
    "@playwright/test": "1.62.1"
  }
}
