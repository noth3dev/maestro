{
  "extends": "../../tsconfig.json",
  "references": [
    {
      "path": "../evidence"
    },
    {
      "path": "../domain"
    },
    {
      "path": "../authority"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../git-adapter"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
